{
  "name": "voltera-blockchain",
  "version": "1.0.0",
  "description": "Contrato de anclaje de liquidaciones P2P de Voltera en Polygon Amoy (testnet gratuita)",
  "license": "MIT",
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "deploy:amoy": "hardhat run scripts/deploy.js --network amoy",
