        <mxCell id="e-bcgw-com" value="JSON-RPC (padrón)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#D2691E;strokeWidth=1.4;fontSize=10;fontColor=#B5651D;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="bc-gw" target="bc-com"><mxGeometry relative="1" as="geometry"/></mxCell>
