        <mxCell id="bc-com" value="Contrato ComunidadEnergeticaRegistry&#10;tecnología: &lt;b&gt;Solidity&lt;/b&gt; + &lt;b&gt;Hardhat&lt;/b&gt; · &#9888; escrito+probado (9 tests), NO desplegado&#10;hoy: comunidad = metadato OFF-CHAIN&#10;puedenCasar() = misma comunidad (gate 1/4/7)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDE0C2;strokeColor=#D2691E;strokeWidth=2;dashed=1;fontSize=11;fontColor=#1A1A1A;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2050" y="960" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="bc-multisig" value="Contrato CesionCertificadoMultisig &lt;b&gt;NUEVO&lt;/b&gt;&#10;patrón &lt;b&gt;MULTIPLE AUTHORIZATION&lt;/b&gt; (familia seguridad)&#10;&#9888; escrito+probado (11 tests), NO desplegado&#10;2 firmas distintas antes de REGISTRAR (proponer→confirmar)&#10;cesión de certificados de origen · no repudio reforzado" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDE0C2;strokeColor=#D2691E;strokeWidth=2;dashed=1;fontSize=11;fontColor=#1A1A1A;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1690" y="1035" width="330" height="120" as="geometry"/></mxCell>
        <mxCell id="bc-nft" value="Contrato CertificadoOrigenNFT &lt;b&gt;NUEVO&lt;/b&gt;&#10;patrón &lt;b&gt;TOKENIZACIÓN · NFT ERC-721&lt;/b&gt; (familia datos)&#10;&lt;b&gt;token NO fungible&lt;/b&gt; (OpenZeppelin)&#10;atributos: ID medidor · propietario · emisor · consumo neto · periodo&#10;ON-CHAIN: propiedad + transferencias billetera→billetera + hash&#10;OFF-CHAIN: tokenURI (metadata IPFS) · unicidad (medidor,periodo)&#10;backend /api/v1/certificados · front /certificados&#10;&#9888; 9 tests contrato + 7 gateway · NO desplegado (gas)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDE0C2;strokeColor=#D2691E;strokeWidth=2;dashed=1;fontSize=10;fontColor=#1A1A1A;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2030" y="1035" width="320" height="140" as="geometry"/></mxCell>

