        <mxCell id="ms-cert-gen" value="certificacion-generacion-service (:8102) &lt;b&gt;NUEVO · lámina 04&lt;/b&gt;&#10;BC Certificación de generación&#10;agregados: BalanceGeneracionCertificable + SolicitudCertificacion&#10;reserva bloques de 1 MWh sin reutilizar mediciones + doble aval&#10;&lt;b&gt;NO toca la cadena&lt;/b&gt; (dominio off-chain)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FCEE9C;strokeColor=#C9A227;strokeWidth=1.6;dashed=1;fontSize=10;fontColor=#1A1A1A;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1690" y="1170" width="320" height="70" as="geometry"/></mxCell>
