        <mxCell id="stacklbl" value="STACK TECNOLÓGICO:  Angular 18 · Vercel (BFF serverless) · WSO2 API Manager · Istio (service mesh, mTLS) · Spring Boot 3.3 / Java 21 · Redpanda/Apache Kafka · KEDA (autoscaling) · PostgreSQL / Redis / TSDB · Kubernetes · Prometheus · Grafana · Kiali · Jaeger · Docker · Render (PaaS) · Hardhat + Solidity · web3j · Polygon Amoy (EVM L2) · ComunidadEnergeticaRegistry (padrón on-chain) · CesionCertificadoMultisig (multiple authorization) · CertificadoOrigenNFT (ERC-721 no fungible, OpenZeppelin)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="54" y="92" width="2290" height="34" as="geometry"/></mxCell>

