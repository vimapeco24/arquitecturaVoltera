<mxfile host="app.diagrams.net" agent="Voltera-Generator" type="device">
  <diagram id="flujo-experimento-p2p" name="Flujo Experimento P2P">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1760" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ================= TÍTULO ================= -->
        <mxCell id="title" value="VOLTERA — Flujo del experimento (Marketplace P2P + anclaje on-chain)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontColor=#1A2E5A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="34" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Secuencia real leída del código (blockchain.component.ts → liquidacion-p2p → blockchain-gateway → Polygon Amoy). El libro de órdenes vive en el navegador (localStorage); solo al CASAR se crean contrato + anclaje." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#555;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="2100" height="18" as="geometry"/></mxCell>

        <!-- ================= ACTORES (cabecera) ================= -->
        <mxCell id="a-pro" value="&lt;b&gt;Prosumidor&lt;/b&gt;&#10;(usuario)" style="shape=umlActor;verticalLabelPosition=bottom;labelBackgroundColor=none;verticalAlign=top;html=1;outlineConnect=0;fillColor=#CCE5FF;strokeColor=#3A7BD5;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="95" width="50" height="90" as="geometry"/></mxCell>
        <mxCell id="a-front" value="&lt;b&gt;Front Angular&lt;/b&gt;&#10;página /blockchain · Vercel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCE5FF;strokeColor=#3A7BD5;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="360" y="100" width="230" height="56" as="geometry"/></mxCell>
        <mxCell id="a-ls" value="&lt;b&gt;localStorage&lt;/b&gt;&#10;libro de órdenes (navegador)" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;html=1;fillColor=#E8F0FE;strokeColor=#3A7BD5;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="720" y="92" width="190" height="72" as="geometry"/></mxCell>
        <mxCell id="a-p2p" value="&lt;b&gt;liquidacion-p2p&lt;/b&gt;&#10;:8081 · clúster k8s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEE9C;strokeColor=#C9A227;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1040" y="100" width="220" height="56" as="geometry"/></mxCell>
        <mxCell id="a-gw" value="&lt;b&gt;blockchain-gateway&lt;/b&gt;&#10;:8101 · Render (PaaS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE0C2;strokeColor=#D2691E;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1430" y="100" width="230" height="56" as="geometry"/></mxCell>
        <mxCell id="a-chain" value="&lt;b&gt;Polygon Amoy&lt;/b&gt;&#10;contrato 0xd0Ef…Bcf530 · chainId 80002" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE0C2;strokeColor=#D2691E;strokeWidth=2.5;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1830" y="92" width="280" height="72" as="geometry"/></mxCell>

        <!-- ================= LIFELINES (líneas verticales, X = centro de cada actor) ================= -->
        <!-- Pro=115, Front=475, LS=815, P2P=1150, GW=1545, Chain=1970 -->
        <mxCell id="ll-pro" style="endArrow=none;dashed=1;dashPattern=4 4;strokeColor=#3A7BD5;strokeWidth=1.5;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="115" y="190" as="sourcePoint"/><mxPoint x="115" y="1640" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ll-front" style="endArrow=none;dashed=1;dashPattern=4 4;strokeColor=#3A7BD5;strokeWidth=1.5;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="475" y="190" as="sourcePoint"/><mxPoint x="475" y="1640" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ll-ls" style="endArrow=none;dashed=1;dashPattern=4 4;strokeColor=#3A7BD5;strokeWidth=1.3;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="815" y="190" as="sourcePoint"/><mxPoint x="815" y="1640" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ll-p2p" style="endArrow=none;dashed=1;dashPattern=4 4;strokeColor=#C9A227;strokeWidth=1.5;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1150" y="190" as="sourcePoint"/><mxPoint x="1150" y="1640" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ll-gw" style="endArrow=none;dashed=1;dashPattern=4 4;strokeColor=#D2691E;strokeWidth=1.5;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1545" y="190" as="sourcePoint"/><mxPoint x="1545" y="1640" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ll-chain" style="endArrow=none;dashed=1;dashPattern=4 4;strokeColor=#D2691E;strokeWidth=1.5;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1970" y="190" as="sourcePoint"/><mxPoint x="1970" y="1640" as="targetPoint"/></mxGeometry></mxCell>

        <!-- ================= PASO 1 ================= -->
        <mxCell id="ph1" value="PASO 1 · Publicar ofertas (NO toca blockchain)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF6FF;strokeColor=#AED0F5;strokeWidth=1;opacity=40;verticalAlign=top;align=left;fontSize=14;fontColor=#3A6BB5;fontStyle=1;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="205" width="2100" height="130" as="geometry"/></mxCell>
        <mxCell id="m1" value="publicar() — tipo, prosumidor, comunidad, kWh, precio" style="endArrow=block;endFill=1;html=1;strokeColor=#3A7BD5;strokeWidth=1.8;fontSize=12;fontColor=#1A3A66;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="115" y="260" as="sourcePoint"/><mxPoint x="475" y="260" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m2" value="guarda orden en el libro (VENTA / COMPRA)" style="endArrow=block;endFill=1;html=1;strokeColor=#3A7BD5;strokeWidth=1.6;fontSize=12;fontColor=#1A3A66;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="475" y="305" as="sourcePoint"/><mxPoint x="815" y="305" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n1" value="El libro (Ventas/Compras) se persiste SOLO en el navegador. Nada on-chain todavía." style="shape=note;whiteSpace=wrap;html=1;fillColor=#F5FAFF;strokeColor=#AED0F5;fontSize=11;fontColor=#3A6BB5;align=left;verticalAlign=top;spacing=6;size=12;" vertex="1" parent="1"><mxGeometry x="1300" y="250" width="500" height="50" as="geometry"/></mxCell>

        <!-- ================= PASO 2 ================= -->
        <mxCell id="ph2" value="PASO 2 · Seleccionar 1 venta + 1 compra → validar reglas de casación" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#E8D48A;strokeWidth=1;opacity=40;verticalAlign=top;align=left;fontSize=14;fontColor=#8A6D1B;fontStyle=1;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="345" width="2100" height="170" as="geometry"/></mxCell>
        <mxCell id="m3" value="seleccionarVenta() + seleccionarCompra()" style="endArrow=block;endFill=1;html=1;strokeColor=#3A7BD5;strokeWidth=1.8;fontSize=12;fontColor=#1A3A66;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="115" y="400" as="sourcePoint"/><mxPoint x="475" y="400" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="selfvalid" value="get puedeCasar():&#10;1) MISMA comunidad energética&#10;2) prosumidores DISTINTOS&#10;3) precio VENTA ≤ precio COMPRA&#10;→ kwhCasables = min(ventaKwh, compraKwh)" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FDF8E3;strokeColor=#C9A227;fontSize=12;fontColor=#8A6D1B;align=left;verticalAlign=top;spacing=6;size=14;" vertex="1" parent="1"><mxGeometry x="300" y="415" width="380" height="90" as="geometry"/></mxCell>
        <mxCell id="n2" value="Ej. de tu pantalla: PRO-SOLAR-01 (venta · SOLAR-01 · 420) casa con PRO-CASA-07 (compra · SOLAR-01 · 500) → 420 ≤ 500 ✓.&#10;PRO-SOLAR-02 es EOLICA-02 → NO casa (distinta comunidad)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FDF8E3;strokeColor=#C9A227;fontSize=11;fontColor=#8A6D1B;align=left;verticalAlign=top;spacing=6;size=12;" vertex="1" parent="1"><mxGeometry x="720" y="415" width="860" height="66" as="geometry"/></mxCell>

        <!-- ================= PASO 3 ================= -->
        <mxCell id="ph3" value="PASO 3 · &quot;Casar y anclar contrato&quot; — casar() dispara 2 llamadas SECUENCIALES" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2E6;strokeColor=#F2C089;strokeWidth=1;opacity=45;verticalAlign=top;align=left;fontSize=14;fontColor=#B5651D;fontStyle=1;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="525" width="2100" height="470" as="geometry"/></mxCell>

        <mxCell id="n3rutas" value="DOS CAMINOS DE RED (producción, verificado en vivo):&#10;• CASAR → BFF Vercel /api/gw → WSO2 :3000 (LAN) → liquidacion-p2p. Requiere token OAuth2 (/api/token).&#10;• ANCLAR → DIRECTO a Render (blockchainBase). WSO2 vive en LAN privada, inalcanzable desde Vercel." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF4E8;strokeColor=#B5651D;fontSize=11;fontColor=#8A4B12;align=left;verticalAlign=top;spacing=6;size=14;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1660" y="560" width="470" height="90" as="geometry"/></mxCell>

        <mxCell id="m4" value="click &quot;Casar y anclar&quot;" style="endArrow=block;endFill=1;html=1;strokeColor=#3A7BD5;strokeWidth=1.8;fontSize=12;fontColor=#1A3A66;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="115" y="575" as="sourcePoint"/><mxPoint x="475" y="575" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="lbl31" value="(1) CASAR" style="text;html=1;fillColor=none;strokeColor=none;fontSize=13;fontColor=#8A6D1B;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="360" y="605" width="200" height="18" as="geometry"/></mxCell>
        <mxCell id="m5" value="p2p.emparejar(…)  —  POST /liquidacion-p2p/v1/api/v1/transacciones/emparejar  (Bearer OAuth2)" style="endArrow=block;endFill=1;html=1;strokeColor=#C9A227;strokeWidth=2;fontSize=12;fontColor=#8A6D1B;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="475" y="635" as="sourcePoint"/><mxPoint x="1150" y="635" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p2plogic" value="crea contrato P2P: kWh casados = min(oferta,demanda), precio de casación, valorTotal, tipoCasacion, pendienteVenta/CompraKwh" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FDF8E3;strokeColor=#C9A227;fontSize=11;fontColor=#8A6D1B;align=left;verticalAlign=top;spacing=6;size=12;" vertex="1" parent="1"><mxGeometry x="990" y="655" width="340" height="56" as="geometry"/></mxCell>
        <mxCell id="m6" value="TransaccionP2P (id, energiaKwh, precioCasacionKwh, valorTotal, liquidadaEn)" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#C9A227;strokeWidth=1.8;fontSize=12;fontColor=#8A6D1B;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1150" y="730" as="sourcePoint"/><mxPoint x="475" y="730" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m6b" value="aplicarCasacionAlLibro() → retira/reduce las órdenes casadas" style="endArrow=block;endFill=1;html=1;strokeColor=#3A7BD5;strokeWidth=1.4;fontSize=11;fontColor=#1A3A66;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="475" y="765" as="sourcePoint"/><mxPoint x="815" y="765" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="lbl32" value="(2) ANCLAR  (solo si (1) tuvo éxito — en el callback next:)" style="text;html=1;fillColor=none;strokeColor=none;fontSize=13;fontColor=#B5651D;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="360" y="795" width="640" height="18" as="geometry"/></mxCell>
        <mxCell id="m7" value="bc.anclar(tx + comunidadId)  —  POST /api/v1/anclajes  (DIRECTO a Render)" style="endArrow=block;endFill=1;html=1;strokeColor=#D2691E;strokeWidth=2;fontSize=12;fontColor=#B5651D;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="475" y="825" as="sourcePoint"/><mxPoint x="1545" y="825" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="gwlogic" value="calcula hashCasacion (SHA-256 de los campos); firma y envía tx on-chain (gas dinámico). comunidadId viaja OFF-CHAIN (no entra en el hash)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FDEBDA;strokeColor=#D2691E;fontSize=11;fontColor=#B5651D;align=left;verticalAlign=top;spacing=6;size=12;" vertex="1" parent="1"><mxGeometry x="1380" y="845" width="370" height="58" as="geometry"/></mxCell>
        <mxCell id="m8" value="sendTransaction(hash) — JSON-RPC (dRPC)" style="endArrow=block;endFill=1;html=1;strokeColor=#D2691E;strokeWidth=2;fontSize=12;fontColor=#B5651D;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1545" y="915" as="sourcePoint"/><mxPoint x="1970" y="915" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m9" value="Anclaje estado = PENDIENTE (tx aún no minada)" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#D2691E;strokeWidth=1.8;fontSize=12;fontColor=#B5651D;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1545" y="950" as="sourcePoint"/><mxPoint x="475" y="950" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m9b" value="guarda Contrato (tx + anclaje PENDIENTE + hitos 🤝 ⏳)" style="endArrow=block;endFill=1;html=1;strokeColor=#3A7BD5;strokeWidth=1.4;fontSize=11;fontColor=#1A3A66;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="475" y="980" as="sourcePoint"/><mxPoint x="815" y="980" as="targetPoint"/></mxGeometry></mxCell>

        <!-- ================= PASO 4 ================= -->
        <mxCell id="ph4" value="PASO 4 · Confirmación on-chain (automática · auto-refresco cada 10 s)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF7EC;strokeColor=#B9DDB3;strokeWidth=1;opacity=45;verticalAlign=top;align=left;fontSize=14;fontColor=#4E7A45;fontStyle=1;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="1005" width="2100" height="250" as="geometry"/></mxCell>
        <mxCell id="loopbox" value="loop  [cada 10 s mientras haya anclajes PENDIENTE]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4E7A45;strokeWidth=1.5;verticalAlign=top;align=left;fontSize=12;fontColor=#4E7A45;fontStyle=2;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="420" y="1045" width="1620" height="195" as="geometry"/></mxCell>
        <mxCell id="m10" value="listarContratos() — GET /api/v1/anclajes" style="endArrow=block;endFill=1;html=1;strokeColor=#D2691E;strokeWidth=1.8;fontSize=12;fontColor=#B5651D;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="475" y="1090" as="sourcePoint"/><mxPoint x="1545" y="1090" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m11" value="getTransactionReceipt(txHash) — ¿minada?" style="endArrow=block;endFill=1;html=1;strokeColor=#D2691E;strokeWidth=1.8;fontSize=12;fontColor=#B5651D;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1545" y="1130" as="sourcePoint"/><mxPoint x="1970" y="1130" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m12" value="recibo: bloque, gasUsado" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#D2691E;strokeWidth=1.6;fontSize=12;fontColor=#B5651D;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1970" y="1165" as="sourcePoint"/><mxPoint x="1545" y="1165" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m13" value="Anclaje = CONFIRMADO (txHash, bloque, gasUsado, explorerUrl) → hito ⛓️" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#4E7A45;strokeWidth=1.8;fontSize=12;fontColor=#4E7A45;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1545" y="1200" as="sourcePoint"/><mxPoint x="475" y="1200" as="targetPoint"/></mxGeometry></mxCell>

        <!-- ================= PASO 5 ================= -->
        <mxCell id="ph5" value="PASO 5 · Verificar integridad · Exportar evidencia · Re-sincronizar" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#C9C9C9;strokeWidth=1;opacity=55;verticalAlign=top;align=left;fontSize=14;fontColor=#555;fontStyle=1;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="1265" width="2100" height="290" as="geometry"/></mxCell>
        <mxCell id="m14" value="verificar() — POST /api/v1/anclajes/verificar (recomputa hash y compara)" style="endArrow=block;endFill=1;html=1;strokeColor=#D2691E;strokeWidth=1.8;fontSize=12;fontColor=#B5651D;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="475" y="1320" as="sourcePoint"/><mxPoint x="1545" y="1320" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m15" value="lee hash on-chain (call de solo lectura)" style="endArrow=block;endFill=1;html=1;strokeColor=#D2691E;strokeWidth=1.6;fontSize=12;fontColor=#B5651D;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1545" y="1360" as="sourcePoint"/><mxPoint x="1970" y="1360" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m16" value="integro = (hash local == hash on-chain) → ✓ ok  /  ✗ comprometido" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#4E7A45;strokeWidth=1.8;fontSize=12;fontColor=#4E7A45;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1545" y="1400" as="sourcePoint"/><mxPoint x="475" y="1400" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m17" value="exportarCsv() / exportarJson() — evidencia local (descarga archivo)" style="endArrow=block;endFill=1;html=1;strokeColor=#3A7BD5;strokeWidth=1.6;fontSize=12;fontColor=#1A3A66;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="475" y="1445" as="sourcePoint"/><mxPoint x="815" y="1445" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m18" value="rehidratar() — GET /api/v1/anclajes (reconcilia si el gateway de Render reinició / durmió)" style="endArrow=block;endFill=1;html=1;strokeColor=#D2691E;strokeWidth=1.6;fontSize=12;fontColor=#B5651D;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="475" y="1490" as="sourcePoint"/><mxPoint x="1545" y="1490" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n4" value="Al confirmar, los contadores de la cabecera suben solos: CONTRATOS · ON-CHAIN ✓ · KWH CASADOS · VOLUMEN (COP) · PRECIO MEDIO. Sin recargar la página." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#C9C9C9;fontSize=11;fontColor=#555;align=left;verticalAlign=top;spacing=6;size=12;" vertex="1" parent="1"><mxGeometry x="1660" y="1320" width="460" height="60" as="geometry"/></mxCell>

        <!-- Pie -->
        <mxCell id="foot" value="Clave: solo el HASH del contrato viaja a la cadena (trazabilidad sin exponer datos). El libro de órdenes es del cliente (localStorage); liquidacion-p2p crea el contrato de negocio; blockchain-gateway ancla en Polygon Amoy. Fuente: blockchain.component.ts (casar → emparejar → anclar → listar → verificar). Verificado end-to-end el 2026-10-22." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#777;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="1575" width="2100" height="30" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
